---
// Prerendered game catalog homepage with client-side filtering controls.
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAllCategories } from '../lib/categories';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const database = getDatabase();
const games = await getAllGames(database);
const categories = await getAllCategories(database);
const publishers = await getAllPublishers(database);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <form
        class="mb-8 rounded-xl border border-slate-700/50 bg-slate-800/60 p-6"
        data-testid="game-filters"
      >
        <fieldset>
          <legend class="mb-4 text-xl font-medium text-slate-100">Filter games</legend>

          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-medium text-slate-200" for="category-filter">
                Categories
              </label>
              <select
                id="category-filter"
                name="category"
                multiple
                class="min-h-32 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="category-filter"
              >
                {categories.map((category) => (
                  <option value={category.id}>{category.name}</option>
                ))}
              </select>
              <p class="mt-2 text-sm text-slate-400">Hold Ctrl or Command to choose more than one.</p>
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-slate-200" for="publisher-filter">
                Publisher
              </label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <button
              type="submit"
              class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="apply-filters"
            >
              Apply filters
            </button>
            <button
              type="reset"
              class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="reset-filters"
            >
              Reset
            </button>
          </div>
          <p class="mt-4 text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-status">
            Showing all {games.length} games.
          </p>
        </fieldset>
      </form>

      <h2 class="mb-6 text-2xl font-medium text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');

  if (form && status) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const categoryIds = formData.getAll('category').map(String);
      const publisherId = String(formData.get('publisher') ?? '');
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesCategory =
          categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
        const matchesPublisher =
          publisherId === '' || card.dataset.publisherId === publisherId;
        const isVisible = matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        if (isVisible) {
          visibleCount += 1;
        }
      });

      status.textContent = `Showing ${visibleCount} of ${cards.length} games.`;
    });

    form.addEventListener('reset', () => {
      cards.forEach((card) => {
        card.hidden = false;
      });
      status.textContent = `Showing all ${cards.length} games.`;
    });
  }
</script>
